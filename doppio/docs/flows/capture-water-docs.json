{
  "name": "Capture the Water Generator screenshots used by docs/water-generator-guide.md",
  "description": "Run through scripts/capture-water-docs.sh (it strips the NNN- prefix). No engine needed.",
  "fixture": "water",
  "size": [1600, 900],
  "steps": [
    {"action": "wait", "ms": 600, "real_time": true, "label": "let the preview render"},
    {"action": "screenshot", "name": "water-pane"},
    {"action": "reset", "fixture": "water", "preset": "Storm"},
    {"action": "wait", "ms": 600, "real_time": true},
    {"action": "screenshot", "name": "water-storm", "target": "id:editor.pane.water_generator", "padding": 0},
    {"action": "reset", "fixture": "water", "preset": "Tropical Lagoon"},
    {"action": "wait", "ms": 600, "real_time": true},
    {"action": "screenshot", "name": "water-lagoon", "target": "id:editor.pane.water_generator", "padding": 0}
  ]
}
