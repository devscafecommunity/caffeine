#version 450

// Photon GPU ambient-occlusion bake.
// One invocation per AO texel; rays are tested against the static scene triangle
// buffer. The CPU only prepares UV positions/normals and the triangle list.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) readonly buffer Triangles {
    vec4 tri[];
};
layout(set = 0, binding = 1) readonly buffer Positions {
    vec4 positions[];
};
layout(set = 0, binding = 2) readonly buffer Normals {
    vec4 normals[];
};
layout(set = 3, binding = 0, r32f) uniform image2D outAO;
layout(set = 4, binding = 0) uniform Params {
    ivec4 counts; // x triangle count, y texel count, z resolution, w rays
    vec4 params;  // x max distance, y bias
} p;

bool rayTriangle(vec3 origin, vec3 dir, vec3 a, vec3 b, vec3 c, float maxT) {
    vec3 e1 = b - a;
    vec3 e2 = c - a;
    vec3 pv = cross(dir, e2);
    float det = dot(e1, pv);
    if (abs(det) < 1e-8) return false;
    float inv = 1.0 / det;
    vec3 tv = origin - a;
    float u = dot(tv, pv) * inv;
    if (u < 0.0 || u > 1.0) return false;
    vec3 qv = cross(tv, e1);
    float v = dot(dir, qv) * inv;
    if (v < 0.0 || u + v > 1.0) return false;
    float t = dot(e2, qv) * inv;
    return t > 1e-5 && t < maxT;
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    int resolution = p.counts.z;
    if (pixel.x >= resolution || pixel.y >= resolution) return;

    uint index = uint(pixel.y) * uint(resolution) + uint(pixel.x);
    vec3 position = positions[index].xyz;
    vec3 normal = normals[index].xyz;
    if (dot(normal, normal) < 1e-6) {
        imageStore(outAO, pixel, vec4(1.0));
        return;
    }
    normal = normalize(normal);

    vec3 up = abs(normal.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    int rays = max(p.counts.w, 1);
    int triangleCount = p.counts.x;
    float maxDistance = max(p.params.x, 0.01);
    float bias = max(p.params.y, 0.0);
    vec3 origin = position + normal * bias;
    float jitter = hash12(vec2(pixel)) * 6.2831853;

    int visible = 0;
    for (int r = 0; r < 64; ++r) {
        if (r >= rays) break;
        float fi = (float(r) + 0.5) / float(rays);
        float phi = float(r) * 2.39996323 + jitter;
        float cosTheta = sqrt(max(0.0, 1.0 - fi));
        float sinTheta = sqrt(fi);
        vec3 local = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
        vec3 dir = normalize(tangent * local.x + bitangent * local.y + normal * local.z);

        bool hit = false;
        for (int t = 0; t < 8192; ++t) {
            if (t >= triangleCount) break;
            int base = t * 3;
            if (rayTriangle(origin, dir, tri[base].xyz, tri[base + 1].xyz, tri[base + 2].xyz,
                            maxDistance)) {
                hit = true;
                break;
            }
        }
        if (!hit) ++visible;
    }

    float ao = float(visible) / float(rays);
    imageStore(outAO, pixel, vec4(ao));
}
